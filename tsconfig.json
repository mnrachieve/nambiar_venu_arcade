{
    "compilerOptions":  {
                            "target":  "ES2017",
                            "lib":  [
                                        "dom",
                                        "dom.iterable",
                                        "esnext"
                                    ],
                            "allowJs":  true,
                            "skipLibCheck":  true,
                            "strict":  false,
                            "noEmit":  true,
                            "incremental":  true,
                            "module":  "esnext",
                            "esModuleInterop":  true,
                            "moduleResolution":  "node",
                            "resolveJsonModule":  true,
                            "isolatedModules":  true,
                            "jsx":  "preserve",
                            "plugins":  [
                                            {
                                                "name":  "next"
                                            }
                                        ]
                        },
    "include":  [
                    "next-env.d.ts",
                    "app/**/*.ts",
                    "app/**/*.tsx",
                    "next.config.ts",
                    ".next-cache/types/**/*.ts",
                    ".next/types/**/*.ts"
                ],
    "exclude":  [
                    "node_modules",
                    "venu-arcade",
                    ".next-brochure"
                ]
}
